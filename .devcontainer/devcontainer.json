{
	"name": "algores",
	"build": {
		"context": "..",
		"dockerfile": "../dockerfile"
	},
	"containerEnv": {"LANG": "C.UTF-8"},
	"workspaceMount": "source=${localWorkspaceFolder},target=/home/alice/algores,type=bind",
	"workspaceFolder": "/home/alice/algores",
	"runArgs": [
        "--sysctl", "net.ipv4.ip_unprivileged_port_start=1024"
	]
}
